{
  "name": "frapp",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "npx --no-install infisical run --env=local --path=/ -- npm run start:dev -w apps/api",
    "dev:web": "npx --no-install infisical run --env=local --path=/ -- npm run dev -w apps/web",
    "dev:landing": "npx --no-install infisical run --env=local --path=/ -- npm run dev -w apps/landing",
    "dev:stack": "npx --no-install infisical run --env=local --path=/ -- concurrently -n api,web,landing -c blue,green,yellow \"npm run start:dev -w apps/api\" \"npm run dev -w apps/web\" \"npm run dev -w apps/landing\"",
    "dev:mobile": "npx --no-install infisical run --env=local --path=/ -- npm run start -w apps/mobile",
    "lint": "turbo run lint",
    "lint:api": "npm run lint -w apps/api",
    "lint:api:fix": "npm run lint:fix -w apps/api",
    "ci:local-gate": "node scripts/run-local-ci-gate.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "check:api-contract": "node scripts/check-api-contract-drift.mjs",
    "check:migration-safety": "node scripts/check-migration-safety.mjs",
    "check:pglite-migrations": "node scripts/check-pglite-migrations.mjs",
    "check:secrets": "node scripts/scan-secrets.mjs",
    "sync:brand-assets": "node scripts/sync-brand-assets.mjs",
    "check:brand-assets": "node scripts/check-brand-assets.mjs",
    "configure:branch-protection": "node scripts/configure-branch-protection.mjs",
    "test:ci-scripts": "node --test scripts/ci/__tests__/*.test.mjs",
    "prepare": "node -e \"try{const fs=require('fs');if(fs.existsSync('scripts/setup-git-hooks.mjs'))require('child_process').execFileSync(process.execPath,['scripts/setup-git-hooks.mjs'],{stdio:'inherit'})}catch{}\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "@electric-sql/pglite": "^0.4.6",
    "@infisical/cli": "0.43.40",
    "prettier": "^3.7.4",
    "turbo": "^2.8.7",
    "typescript": "5.9.2"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "handlebars": "^4.7.9",
    "minimatch": "^10.2.3",
    "picomatch": "^4.0.4",
    "fast-uri": "^3.1.2",
    "flatted": "^3.4.2",
    "node-forge": "^1.4.0",
    "undici": ">=7.29.0 <8.0.0",
    "path-to-regexp": "^8.4.0",
    "yaml": "^2.9.0",
    "@xmldom/xmldom": ">=0.8.13",
    "@nestjs/swagger": {
      "js-yaml": "^5.2.2"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
