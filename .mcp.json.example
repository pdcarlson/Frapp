{
  "_README": "Local-reference only for the Linear MCP — see ADR-16 (spec/architecture/README.md) and docs/internal/ci-cd/LINEAR_PM.md. This file is NOT loaded by any tool (it is a .example); auth is OAuth (no API key). Claude Code (local): run `claude mcp add --transport http linear-server https://mcp.linear.app/mcp` then `/mcp` to authenticate. Claude Code on the web: the web environment injects this server, so cloud sessions inherit it — do NOT commit a root .mcp.json (it would double-register). Cursor: use its native Linear integration (Settings → MCP → Linear one-click) — no committed .cursor/mcp.json needed.",
  "mcpServers": {
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    }
  }
}
