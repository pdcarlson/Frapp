{
  "_README": "Local-reference only for the Linear MCP — see ADR-16 (spec/architecture/README.md) and docs/internal/ci-cd/LINEAR_PM.md. This file is NOT loaded by any tool (it is a .example); auth is OAuth (no API key). Claude Code (local): run `claude mcp add --transport http linear-server https://mcp.linear.app/mcp` then `/mcp` to authenticate. Claude Code on the web: the web environment injects this server, so cloud sessions inherit it — do NOT commit a root .mcp.json (it would double-register). Cursor: the interactive IDE uses Cursor's native Linear integration; the headless Cursor automations use a LINEAR_API_KEY (a Cursor cloud-agent secret) against Linear's GraphQL API — see docs/internal/ci-cd/CURSOR_AUTOMATIONS.md. No committed .cursor/mcp.json.",
  "mcpServers": {
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    }
  }
}
