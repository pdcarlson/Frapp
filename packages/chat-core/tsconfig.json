{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    // This package has no build — `apps/web` (and `apps/mobile` next) consume
    // `src/*.ts` directly through their own bundlers, same as `@repo/theme`
    // and `@repo/chat-integrations`' import condition. Relative imports here
    // are extensionless and must be resolved the way those bundlers resolve
    // them, not the way NodeNext would — NodeNext would also choke on
    // `@repo/chat-integrations`' deliberately non-Node dist (see that
    // package's index header).
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
