{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    // This package has no build — `apps/web` and `apps/mobile` consume
    // `src/*.ts` directly through their own bundlers, same as `@repo/theme`.
    // Relative imports here are extensionless and must be resolved the way
    // those bundlers resolve them, not the way NodeNext would: Turbopack
    // cannot resolve a `./parsers.js` specifier against `parsers.ts` (#918).
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
