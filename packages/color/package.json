{
  "name": "@repo/color",
  "version": "0.0.0",
  "private": true,
  "description": "Zero-dependency WCAG contrast math. DOM-free and CJS-safe, so both the bundled theme packages and the NestJS API can share one implementation.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "typescript": "5.9.2",
    "vitest": "^4.1.10"
  }
}
