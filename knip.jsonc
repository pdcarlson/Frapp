// Knip finds unused files, exports and dependencies: `npm run check:knip`.
// Advisory, not a CI gate. Everything below exists to stop a false positive;
// say why when you add to it, so the next reader can tell a real exception
// from a hidden finding.
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      // Scripts run by hand, from CI workflows or from npm scripts.
      "entry": [
        "scripts/**/*.{mjs,cjs,js,ts}",
        "supabase/functions/*/index.ts",
        "supabase/functions/**/*.test.ts",
      ],
      "project": ["scripts/**/*.{mjs,cjs,js,ts}", "supabase/functions/**/*.ts"],
      "ignoreDependencies": [
        // Run after `infisical run --` in `dev:stack`, which knip doesn't parse.
        "concurrently",
        // Run as node_modules/.bin/squawk by check-migration-lock-safety.mjs.
        "squawk-cli",
        // Only hand-run scripts import these: supabase-js is hoisted from the
        // apps, playwright arrives through @playwright/test.
        "@supabase/supabase-js",
        "playwright",
      ],
    },
    "apps/api": {
      "entry": [
        "src/main.ts",
        // One-off backfills run by hand with ts-node.
        "src/backfill-*.ts",
        "test/**/*.ts",
        // Compile-time checks: tsc type-checks them, nothing imports them.
        "src/infrastructure/supabase/database.types.insert-check.ts",
        "src/interface/dtos/service-input-coverage.ts",
      ],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      // Transitive packages of @supabase/supabase-js, imported for a type and
      // a spec.
      "ignoreDependencies": ["@supabase/realtime-js", "@supabase/storage-js"],
    },
    "apps/desktop": {
      // The preload, which Electron loads by path (package.json `main` covers the rest).
      "entry": ["src/preload/index.ts"],
      "eslint": { "config": ["eslint.config.mjs"] },
    },
    "apps/mobile": {
      // Metro picks a platform file by suffix, which knip can't follow.
      "entry": ["**/*.{native,web,ios,android}.{ts,tsx}"],
      "ignoreDependencies": [
        // Native modules Expo needs installed though no file imports them.
        "@expo/vector-icons",
        "expo-font",
        // babel.config.js names it; `expo` depends on it, so it arrives with
        // `expo`, as in Expo's own template.
        "babel-preset-expo",
        // Expo's plugin asks for it because app.json sets
        // `userInterfaceStyle`, which Android applies only through this
        // module. Not installed: pending an Android build check, #4544.
        "expo-system-ui",
      ],
    },
    // The packages are private, so an export nothing imports is dead even
    // when package.json exports the file.
    "packages/*": {
      "includeEntryExports": true,
      "eslint": { "config": ["eslint.config.mjs"] },
      "ignoreDependencies": ["eslint"],
    },
  },
  "ignoreIssues": {
    // Vendored from Radix; kept whole so it diffs cleanly against upstream.
    "packages/chapter-theme/src/vendor/**": ["exports"],
    // Generated by openapi-typescript, which always emits these top-level types.
    "packages/api-sdk/src/types.ts": ["types"],
    // Declarations for search-indexing.mjs: the apps import the .mjs, which
    // these type, so knip never sees a consumer of the .d.mts itself.
    "packages/validation/search-indexing.d.mts": ["exports"],
  },
  // Every workspace lints through @repo/eslint-config, which owns eslint; the
  // rest are system binaries the scripts expect on PATH (faketime is
  // libfaketime, which clock-ahead-tests.yml installs with apt).
  "ignoreBinaries": ["eslint", "gitleaks", "jq", "flock", "supabase", "faketime"],
  // The API's DTO drift guards (apps/api/src/interface/dtos/drift-guard.ts):
  // type aliases tsc checks and nothing imports, exported only so ESLint's
  // no-unused-vars accepts them.
  "tags": ["-driftguard"],
}
