{
  "name": "api",
  "version": "0.0.1",
  "imports": {
    "#domain/entities": {
      "types": "./src/domain/entities/index.ts",
      "source": "./src/domain/entities/index.ts",
      "default": "./dist/domain/entities/index.js"
    },
    "#domain/*": {
      "types": "./src/domain/*.ts",
      "source": "./src/domain/*.ts",
      "default": "./dist/domain/*.js"
    },
    "#test/*": {
      "types": "./test/*.ts",
      "source": "./test/*.ts",
      "default": null
    }
  },
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "check-types": "tsc --noEmit -p tsconfig.build.json",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:integration": "jest --config ./test/integration/jest-integration.json",
    "test:ai-evals": "jest --config ./test/ai-evals/jest-ai-evals.json",
    "openapi:export": "node --conditions=source -r ts-node/register src/export-openapi.ts"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.3",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@repo/chapter-theme": "*",
    "@repo/org-archetypes": "*",
    "@repo/validation": "*",
    "@sentry/nestjs": "^10.71.0",
    "@supabase/supabase-js": "^2.112.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "discord-api-types": "^0.38.53",
    "expo-server-sdk": "^7.2.0",
    "helmet": "^8.3.0",
    "pdf-lib": "^1.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^22.6.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@darraghor/eslint-plugin-nestjs-typed": "^7.3.4",
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.5.13",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "jest": "^30.5.0",
    "prettier": "^3.9.6",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.68.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "rootDir": ".",
            "ignoreDeprecations": "6.0"
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "coverageProvider": "v8",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^#domain/(.*)$": "<rootDir>/domain/$1",
      "^#test/(.*)$": "<rootDir>/../test/$1"
    }
  }
}
