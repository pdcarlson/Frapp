{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".eval-spec.ts$",
  "moduleNameMapper": {
    "^#domain/(.*)$": "<rootDir>/../../src/domain/$1",
    "^#test/(.*)$": "<rootDir>/../$1",
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": {
          "module": "commonjs",
          "moduleResolution": "node",
          "resolvePackageJsonExports": false,
          "rootDir": ".",
          "ignoreDeprecations": "6.0"
        }
      }
    ]
  }
}
