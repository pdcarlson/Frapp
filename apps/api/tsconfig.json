{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    // ES2022+ targets default this to true, which emits every declared field,
    // so `class-transformer` builds each DTO with an own `undefined` for every
    // optional key the request left out. Code reading a DTO as parsed JSON
    // then sees keys nobody sent: the config PATCH's branding merge wrote them
    // over the stored values and wiped a chapter's accent, letters and
    // founding year with a Save mark. False keeps a DTO to the keys the
    // client sent.
    "useDefineForClassFields": false,
    "sourceMap": true,
    "outDir": "./dist",
    // Do not set `rootDir` here. This program includes `src/` and `test/`
    // (ESLint's project service). An explicit `"."` would let a stray
    // `tsc -p tsconfig.json` emit dist/src/main.js instead of failing
    // TS5011; `"./src"` would exclude `test/` from the ESLint project.
    // Emit uses `tsconfig.build.json`, which sets `"rootDir": "./src"`.
    "incremental": true,
    "skipLibCheck": true,
    // TypeScript 6/7 default `types` to `[]`, so without jest here every spec's
    // `describe` / `jest.fn` is an unresolved name; `tsconfig.build.json`
    // narrows it to `["node"]`. Why `check-types` runs both programs, and with
    // `--incremental false`: docs/ci-cd/agent-infra.md § TypeScript 7.
    "types": ["node", "jest"],
    // TypeScript 6/7 default `strict` to true. This app never opted into the
    // full bundle — only the flags below. Nest DTO class fields are assigned
    // by class-validator, not constructors, so `strictPropertyInitialization`
    // would be hundreds of TS2564s with no runtime meaning.
    "strict": false,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true
  }
}
