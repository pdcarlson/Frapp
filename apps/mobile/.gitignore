# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Play service-account key for `eas submit` — a real key dropped at this path
# must never be stageable.
play-service-account.json

# Firebase's Android client config, read by app.config.js when present so a
# local build can package it. Production builds get it from the EAS file
# environment variable GOOGLE_SERVICES_JSON instead (ENV_REFERENCE.md § Mobile);
# it carries a Google API key that gitleaks flags, so it stays untracked.
google-services.json

# Written at prebuild by the @sentry/react-native/expo config plugin, at the
# project root rather than inside the ignored /ios and /android output. Both are
# generated, so tracking them would be noise — and sentry.properties is the file
# an `auth.token=` line lands in if anyone ever sets `authToken` in the plugin
# config instead of the SENTRY_AUTH_TOKEN environment variable.
sentry.properties
sentry.options.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
