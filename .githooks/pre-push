#!/usr/bin/env bash
# Refuse to push a ref whose tip carries changes nobody reviewed. Only each ref's tip
# is checked: the review covers the branch's net change, not every commit on the way
# (secrets in any commit are pre-commit's job). Installed through core.hooksPath by
# scripts/setup-git-hooks.mjs.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
ZERO_SHA=0000000000000000000000000000000000000000
missing=0

# Git supplies one line per ref update on stdin. Deletions have a zero local SHA and
# publish no commit, so there is nothing to review. Every other update is keyed to
# the exact object being pushed rather than whichever commit HEAD names later.
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  [ "$local_sha" = "$ZERO_SHA" ] && continue

  # Annotated tags point at tag objects. Peel them so review evidence remains a
  # commit-keyed contract; reject objects that do not ultimately name a commit.
  if ! pushed_commit="$(git rev-parse "${local_sha}^{commit}" 2>/dev/null)"; then
    printf 'review-gate: cannot resolve %s (%s) to a commit; refusing push.\n' \
      "$local_ref" "$local_sha" >&2
    missing=1
    continue
  fi

  # The scope script owns the rule: /diff-review's marker on this commit, or
  # nothing unreviewed in it (already on origin/main, or only clean merges of
  # main since a reviewed commit). Any failure to run it (no node, no
  # origin/main) denies.
  if ! node "$ROOT/scripts/diff-review-scope.mjs" --check "$pushed_commit"; then
    printf 'review-gate: no review evidence for %s (%s).\n' "$local_ref" "$pushed_commit" >&2
    printf 'Run /diff-review on that commit; it records the evidence at %s once its findings are handled.\n' \
      "$ROOT/.cache/diff-review/$pushed_commit" >&2
    missing=1
  fi
done

if [ "$missing" -ne 0 ]; then
  printf 'review-gate: push denied. Retrying cannot create review evidence. Emergency bypass: git push --no-verify.\n' >&2
  exit 1
fi
