# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Cloud sandbox bringup sentinels (scripts/cloud-sandbox-up.sh)
.cloud-sandbox-up.done
.cloud-sandbox-up.failed
# Egress capability manifest (scripts/cloud-sandbox-egress-probe.sh) — per-session state,
# never committed: it describes one environment's network policy at one moment.
.cloud-sandbox-capabilities.json

# Testing
coverage
# Unanchored, so a Playwright run started from the repo root (or any workspace)
# is covered too — the `apps/web/`-anchored form left root-level artifacts
# stageable, and `test-results/.last-run.json` duly got committed once.
playwright-report/
test-results/

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Supabase
supabase/.temp/
supabase/.branches/

# Misc
.DS_Store
*.pem

# Local editor state (incl. the retired Cursor IDE — .cursor/mcp.json can carry credentials).
# Ignore everything under .cursor/ EXCEPT the committed Cloud Agent environment config
# (.cursor/environment.json is repo-managed and carries no secrets). The `.cursor/*` form
# (not `.cursor/`) is required so git still descends into the dir to honor the negation.
.cursor/*
!.cursor/environment.json

# Agent-local state, never committed:
#   settings.local.json holds one machine's permission grants (previously ignored
#   only by a developer's global gitignore, so a fresh clone left it stageable);
#   worktrees/ holds nested git worktrees created under the repo root.
.claude/settings.local.json
.claude/worktrees/

# Tooling binary + marker cache. One entry rather than one per tool, so a newly
# cached tool does not show up untracked: .cache/ is written by
# scripts/install-{lychee,gitleaks,oasdiff}.sh, scripts/lib/cloud-sandbox-common.sh
# (supabase-cli), and /diff-review (diff-review/ HEAD markers). Nothing under it
# is ever tracked.
/.cache/

# link checker binary (never committed). The root-level patterns cover a manual
# download, which check-links.mjs still finds via PATH; the cached copy that
# scripts/install-lychee.sh writes is covered by .cache/ above.
/lychee
lychee-*.tar.gz
lychee-*/

# jscpd duplicate-detection report (regenerated by `npm run check:duplication`;
# the threshold in .jscpd.json is the committed artifact, not the report)
.jscpd/

# TypeScript incremental build cache (regenerated by every `tsc -p`).
*.tsbuildinfo

# Generated demo/marketing screenshots (scripts/demo/capture-*.mjs).
# Regenerate rather than commit: DOCUMENTATION_CONVENTIONS.md forbids inventing a
# new top-level folder, and no existing one is a home for generated marketing
# binaries.
screenshots/
