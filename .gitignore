# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Cloud sandbox bringup sentinels (scripts/cloud-sandbox-up.sh)
.cloud-sandbox-up.done
.cloud-sandbox-up.failed
# Egress capability manifest (scripts/cloud-sandbox-egress-probe.sh) — per-session state,
# never committed: it describes one environment's network policy at one moment.
.cloud-sandbox-capabilities.json

# Testing
coverage
# Unanchored, so a Playwright run started from the repo root (or any workspace)
# is covered too — the `apps/web/`-anchored form left root-level artifacts
# stageable, and `test-results/.last-run.json` duly got committed once.
playwright-report/
test-results/

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Supabase
supabase/.temp/
supabase/.branches/

# Misc
.DS_Store
*.pem

# Local editor state (incl. the retired Cursor IDE — .cursor/mcp.json can carry credentials)
.cursor/

# link checker binary (never committed). scripts/install-lychee.sh caches the
# pinned binary under .cache/lychee/; the root-level patterns cover a manual
# download, which check-links.mjs still finds via PATH.
/lychee
lychee-*.tar.gz
lychee-*/
.cache/lychee/

# Tooling binary cache (gitleaks via scripts/install-gitleaks.sh; never committed)
.cache/gitleaks/
# Pinned Supabase CLI for the cloud sandbox (scripts/lib/cloud-sandbox-common.sh)
.cache/supabase-cli/
# Per-HEAD review markers written by /diff-review, read by the pre-push review gate
.cache/diff-review/

# jscpd duplicate-detection report (regenerated by `npm run check:duplication`;
# the threshold in .jscpd.json is the committed artifact, not the report)
.jscpd/

# oasdiff binary, fetched by scripts/install-oasdiff.sh and run by
# scripts/check-api-breaking-changes.mjs
.cache/oasdiff/


# TypeScript incremental build cache (regenerated by every `tsc -p`).
*.tsbuildinfo

# Generated demo/marketing screenshots (scripts/demo/capture-*.mjs).
# Regenerate rather than commit: DOCUMENTATION_CONVENTIONS.md hard rule 1 has no
# home for generated marketing binaries.
screenshots/
