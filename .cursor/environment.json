/*
 * Cursor Cloud public contract for Frapp. Cursor owns this file (schema:
 * https://cursor.com/schemas/environment.schema.json — do not add $schema;
 * unevaluatedProperties is false).
 *
 * install: scripts/cursor-agent-install.sh
 * start: scripts/cursor-agent-start.sh (boot sysctls) → scripts/cursor-cloud-up.sh
 *        (shared bringup: scripts/cloud-sandbox-up.sh). start returns after
 *        dockerd + Supabase + env files; it does not start dev servers.
 * terminals wait on .cloud-sandbox-up.done via scripts/cursor-wait-sandbox.sh
 * then Node 20 (scripts/cursor-node20.sh).
 *
 * Do not put secrets here. User secrets are unavailable during Builds;
 * DOCKERHUB_* must be environment/team secrets. Egress is a dashboard decision
 * (GitHub #2025), not copied into this file.
 */
{
  "name": "Frapp",
  "user": "ubuntu",
  "install": "bash scripts/cursor-agent-install.sh",
  "start": "bash scripts/cursor-agent-start.sh",
  "terminals": [
    {
      "name": "api",
      "command": "bash scripts/cursor-wait-sandbox.sh npm run start:dev -w apps/api",
      "description": "NestJS API (http://localhost:3001, Swagger at /docs). Waits for .cloud-sandbox-up.done (exit 1 if .failed), then Node 20. Reads apps/api/.env.local written by start."
    },
    {
      "name": "web",
      "command": "bash scripts/cursor-wait-sandbox.sh npm run dev -w apps/web",
      "description": "Next.js admin dashboard (http://localhost:3000). Waits for stack sentinels, then Node 20."
    },
    {
      "name": "landing",
      "command": "bash scripts/cursor-wait-sandbox.sh npm run dev -w apps/landing",
      "description": "Next.js marketing site (http://localhost:3002). Waits for stack sentinels, then Node 20."
    }
  ],
  "ports": [
    { "name": "web", "port": 3000 },
    { "name": "api", "port": 3001 },
    { "name": "landing", "port": 3002 },
    { "name": "supabase-api", "port": 54321 },
    { "name": "supabase-studio", "port": 54323 }
  ]
}
